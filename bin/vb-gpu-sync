#!/usr/bin/env python3
"""Turn NVIDIA's CDI spec (/etc/cdi/nvidia.yaml) into plain Podman settings for the builder.

Why not just `AddDevice=nvidia.com/gpu=all`: with --userns=keep-id (coder = you), Podman marks every
CDI mount "ridmap", and the kernel refuses idmapped mounts on those driver files ("mount_setattr:
Operation not permitted"). The same files bind-mount fine without it. So this writes:

  $VB_STATE_DIR/gpu.args                                        podman create arguments: devices +
                                                                 read-only driver mounts (vb-builder-create)
  $VB_STATE_DIR/link/gpu-links.sh                               the CDI hook's symlinks + ldconfig,
                                                                 run (as root) when the builder starts
Run again after an NVIDIA driver update (`vibebuilder gpu-sync`; `install` and `start` do it too).
"""
import os
import shlex
import sys
from pathlib import Path

import yaml

spec_path = Path("/etc/cdi/nvidia.yaml")
# Set by bin/lib/vbconfig.sh (vibebuilder and vb-builder-create run this script).
state = Path(os.environ.get("VB_STATE_DIR") or Path.home() / ".local/share/vibebuilder")
dropin = state / "gpu.args"
links = state / "link/gpu-links.sh"

if not spec_path.exists():
    print("No /etc/cdi/nvidia.yaml: the builder runs without the GPU. "
          "(sudo nvidia-ctk cdi generate --output=/etc/cdi/nvidia.yaml)")
    dropin.unlink(missing_ok=True)
    links.unlink(missing_ok=True)
    sys.exit(0)

spec = yaml.safe_load(spec_path.read_text())
edits = [spec.get("containerEdits") or {}]
edits += [d.get("containerEdits") or {} for d in spec.get("devices", []) if d.get("name") == "all"]

devices, mounts, env, script = [], [], [], ["#!/bin/sh", "# generated by vb-gpu-sync from /etc/cdi/nvidia.yaml"]
for e in edits:
    devices += [n["path"] for n in e.get("deviceNodes", [])]
    for m in e.get("mounts", []):
        opts = [o for o in m.get("options", []) if o in ("ro", "nosuid", "nodev", "noexec")] or ["ro"]
        mounts.append(f'{m["hostPath"]}:{m["containerPath"]}:{",".join(opts)}')
    env += e.get("env", [])
    for h in e.get("hooks", []):
        args = h.get("args", [])
        if "create-symlinks" in args:
            for i, a in enumerate(args):
                if a == "--link" and i + 1 < len(args):
                    target, link = args[i + 1].split("::", 1)
                    script.append(f"mkdir -p {shlex.quote(os.path.dirname(link))} && ln -sfn {shlex.quote(target)} {shlex.quote(link)}")
script.append("ldconfig 2>/dev/null || true")

lines = [f"--device={d}" for d in dict.fromkeys(devices) if os.path.exists(d)]
lines += [f"--volume={m}" for m in dict.fromkeys(mounts) if os.path.exists(m.split(":", 1)[0])]
lines += [f"--env={e}" for e in dict.fromkeys(env) if not e.startswith("NVIDIA_VISIBLE_DEVICES")]
lines += ["--env=NVIDIA_VISIBLE_DEVICES=all", "--env=NVIDIA_DRIVER_CAPABILITIES=all", "--group-add=keep-groups"]
dropin.parent.mkdir(parents=True, exist_ok=True)
dropin.write_text("\n".join(lines) + "\n")
links.parent.mkdir(parents=True, exist_ok=True)
links.write_text("\n".join(script) + "\n")
links.chmod(0o644)
print(f"GPU: {len(set(devices))} devices, {len(set(mounts))} driver files, {len(script) - 3} links.")
