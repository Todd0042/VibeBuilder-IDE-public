#!/usr/bin/env python3
"""Claude Code PostToolUse hook (Edit|Write|MultiEdit|NotebookEdit): tells the builder agent exactly
which file Claude changed, so the IDE's Changes view can label it "claude" with certainty.
Never blocks Claude: any failure is ignored. Usage: vb-edit-hook claude"""

import json
import sys
import urllib.request

try:
    kind = sys.argv[1] if len(sys.argv) > 1 else "claude"
    event = json.load(sys.stdin)
    tool_input = event.get("tool_input") or {}
    path = tool_input.get("file_path") or tool_input.get("notebook_path")
    if path:
        token = open("/run/vb-link/agent_token").read().strip()
        req = urllib.request.Request("http://127.0.0.1:7070/hook", method="POST",
                                     data=json.dumps({"kind": kind, "path": path}).encode(),
                                     headers={"Content-Type": "application/json", "Authorization": f"Bearer {token}"})
        urllib.request.urlopen(req, timeout=1).read()
except Exception:
    pass
sys.exit(0)
