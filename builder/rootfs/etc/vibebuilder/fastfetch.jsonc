// VibeBuilder greeting: what new shell tabs show (see /etc/fish/conf.d/vibebuilder.fish).
{
  "logo": {
    "type": "file",
    "source": "/etc/vibebuilder/fastfetch-logo.txt",
    "color": { "1": "38;5;39", "2": "38;5;208", "3": "38;5;113", "4": "38;5;75" },
    "padding": { "top": 1, "right": 3 }
  },
  "display": { "separator": "  ", "key": { "width": 13 }, "color": { "keys": "38;5;208", "title": "38;5;39" } },
  "modules": [
    { "type": "title", "format": "{user-name}@{host-name} — vibes: immaculate" },
    { "type": "command", "key": "Host", "text": "cat /run/vb-link/host-os 2>/dev/null || echo 'CachyOS (probably)'" },
    { "type": "os", "key": "Box", "format": "{pretty-name}, rootless & roofless" },
    { "type": "kernel", "key": "Kernel" },
    { "type": "uptime", "key": "Awake for" },
    { "type": "cpu", "key": "Brain", "format": "{name} ×{cores-logical}" },
    { "type": "gpu", "key": "Pixel pusher", "format": "{name}" },
    { "type": "memory", "key": "RAM" },
    { "type": "disk", "key": "Workspace", "folders": "/workspace", "format": "{size-used} / {size-total} ({size-percentage})" },
    { "type": "packages", "key": "pacman -Q", "format": "{all} packages, all of them load-bearing" },
    { "type": "command", "key": "✻ Claude", "text": "claude --version 2>/dev/null | cut -d' ' -f1 | sed 's/$/, ready to refactor everything/' || echo 'not installed (yet)'" },
    { "type": "command", "key": "~ agy", "text": "test -x ~/.local/bin/agy && echo 'reporting for duty' || echo 'missing in action'" },
    { "type": "command", "key": "Android", "text": "echo \"SDK $(ls /opt/android-sdk/platforms 2>/dev/null | sed 's/android-//' | sort -n | paste -sd/ -) · phone app: soon™\"" },
    "break",
    { "type": "command", "key": " ", "keyColor": "38;5;244", "text": "shuf -n1 /etc/vibebuilder/quips.txt" }
  ]
}
