# Caddy reverse proxy for VibeBuilder IDE (own domain or free DuckDNS subdomain).
#
# Caddy automatically fetches and renews a Let's Encrypt TLS certificate on port 443
# and handles HTTP + WebSocket upgrades out of the box.
#
# In vibebuilder.env, set:
#   VB_PUBLIC_URL=https://mybox.duckdns.org
#   VB_PROXY=forwarded
#
# Replace mybox.duckdns.org with your hostname and 8765 with VB_SERVER_PORT if changed.

mybox.duckdns.org {
	reverse_proxy 127.0.0.1:8765
}
