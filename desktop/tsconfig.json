{
  "extends": "@tsconfig/svelte/tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "paths": { "@core/*": ["../client-core/src/*"] }
  },
  "include": ["src/**/*.ts", "src/**/*.svelte", "../client-core/src/**/*.ts"]
}
