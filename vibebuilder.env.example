# VibeBuilder IDE: settings for this machine.
# Copy to vibebuilder.env (git-ignored) and edit. Plain KEY=value lines, read by bash.
# Secrets never go here: the authenticator secret and tokens are created by `vibebuilder install`,
# `vibebuilder new-totp` and pairing, and stay in VB_STATE_DIR.

# Required. Where your other devices reach the IDE (the address of your tunnel or reverse proxy).
VB_PUBLIC_URL=https://ide.example.com

# The folder the IDE shows. Agents in the builder can change anything in it.
VB_WORKSPACE_DIR=$HOME/vibebuilder-workspace

# Secrets, history, the builder's home folder, Nix store and pacman cache. Keep it out of the workspace.
VB_STATE_DIR=$HOME/.local/share/vibebuilder

# Optional: put Podman's images and containers on a bigger disk (the builder image is ~10 GB).
# Writes ~/.config/containers/storage.conf on install if that file doesn't exist yet.
#VB_CONTAINER_STORAGE=/mnt/big-disk/containers/storage

# Port on 127.0.0.1 that your tunnel or reverse proxy forwards to.
VB_SERVER_PORT=8765

# How client IP addresses reach vb-server for per-IP sign-in lockouts (see remote-access.md):
#   none       = Tailscale Serve or SSH port forward (safe default; ignores proxy headers)
#   forwarded  = Caddy, Nginx, or Tailscale Funnel (reads the proxy-appended X-Forwarded-For IP)
#   cloudflare = Cloudflare Tunnel only (reads CF-Connecting-IP)
VB_PROXY=none

# The name your authenticator app shows for this server.
VB_TOTP_ISSUER=VibeBuilder

# Builder container limits.
VB_BUILDER_MEMORY=16g
#VB_BUILDER_CPUS=8          # default: all cores

# Session idle timeout in seconds (default: 600 = 10 minutes).
# For trusted personal setups, set to 86400 (24 hours) or 0 (no idle expiration while open).
#VB_SESSION_IDLE_SEC=86400

# Allow internal symlinks inside the workspace (for monorepos, pnpm, npm workspaces, virtualenvs).
# 0 = refuse all symlinks (default); 1 = allow symlinks that stay beneath /workspace.
# Kernel openat2(RESOLVE_BENEATH) prevents symlinks from ever escaping outside /workspace.
#VB_ALLOW_INTERNAL_SYMLINKS=1

# Allow downloading workspace files and opening arbitrary binary assets:
# 0 = refuse download of non-media files (default); 1 = allow downloading files from workspace.
#VB_ALLOW_FILE_DOWNLOAD=1

# Max file size in bytes that can be opened in the IDE editor (default: 33554432 = 32 MB).
# Increase if you work with large prototype datasets or models (e.g. 268435456 = 256 MB).
#VB_MAX_FILE_BYTES=33554432

# Local git checkpoints filter:
# 0 = default (excludes .env, secrets, dependency folders, files > 5 MB).
# 1 = allow all files (including local test .env and larger assets) in local checkpoint commits.
#VB_CHECKPOINT_ALLOW_ALL=1

# Optional, laptop app: your own app id (the keychain entry and saved settings belong to it).
#VB_APP_IDENTIFIER=com.example.vibebuilder-ide
